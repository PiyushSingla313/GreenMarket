# PostgreSQL connection string
# Example for a local Postgres instance:
DATABASE_URL=postgresql+psycopg2://greenmarket:greenmarket@localhost:5432/greenmarket

# For quick local testing with zero setup, you can instead use SQLite:
# DATABASE_URL=sqlite:///./greenmarket.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - comma separated list of allowed origins. Use * for dev only.
CORS_ORIGINS=*
